# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Virtual environments
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Environment
.env

# Scraping artifacts — intermediate build inputs, rebuilt by re-running
# the pipeline. The READMEs are tracked so the directories exist in
# fresh clones.
data/jobs/*
!data/jobs/README.md
data/results/*
!data/results/README.md

# The built database — the product of a build, not an input to one. Rebuilt
# from sources every time, never edited in place.
data/*.db

# Claude
.claude/
