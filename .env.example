# Final Scoring — environment configuration
# Copy this file to `.env` and fill in real values.
#
# All settings are optional unless noted. The build will fail loudly with
# a clear message if a required value is missing.

# ─────────────────────────────────────────────────────────────────────────
# LLM extraction
# ─────────────────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint. Defaults assume a local model served by
# vLLM, Ollama, or llama.cpp. For Ollama:    http://localhost:11434/v1
# For vLLM:    http://localhost:8000/v1
LLM_API_BASE_URL=http://localhost:8000/v1

# API key for the LLM endpoint. Local servers usually accept anything
# non-empty (e.g. "local"). Hosted providers (OpenAI, Anthropic via a
# proxy, etc.) need a real key. Required.
LLM_API_KEY=local

# Model identifier as the LLM server knows it.
# Examples:
#   Qwen/Qwen2.5-14B-Instruct
#   qwen2.5:14b-instruct
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# Optional generation parameters
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096

# ─────────────────────────────────────────────────────────────────────────
# Scraping
# ─────────────────────────────────────────────────────────────────────────
# Identify yourself to upstream sources. Include a contact URL or email.
SCRAPER_USER_AGENT=FinalScoringBot/0.1 (+https://finalscoring.games/about)

# Politeness settings. Defaults are conservative.
SCRAPER_DOWNLOAD_DELAY=1.0
SCRAPER_CONCURRENT_REQUESTS=4

# Where Scrapy writes resume state and JSONL output.
SCRAPER_JOBDIR=data/jobs
SCRAPER_FEED_URI=data/results/%(name)s-%(time)s-%(batch_id)05d.jl
SCRAPER_EXPORT_BATCH_ITEM_COUNT=10000

# ─────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────
# Path to the built SQLite database. The Docker image bakes this in.
FS_DB_PATH=data/final_scoring.db

# Path to Recommend.Games game data import (SQLite, Parquet, or JSON Lines;
# auto-detected by extension). Leave empty to skip import during local dev.
RECOMMEND_GAMES_IMPORT=
