# Final Scoring — environment variable reference
# Copy to .env and edit. Never commit the .env file.

# OpenAI-compatible LLM endpoint (used at build/ingestion time only)
FS_LLM_BASE_URL=http://localhost:11434/v1

# Model name as recognised by the serving endpoint
FS_LLM_MODEL=llama3.2

# Minimum seconds between scraper requests (politeness delay)
FS_SCRAPER_DELAY=1.0

# Path for the output SQLite database file
FS_DB_PATH=data/results/finalscoring.db
