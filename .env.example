# Final Scoring — environment variable reference
# Copy to .env and edit. Never commit the .env file.

# OpenAI-compatible LLM endpoint (used at build/ingestion time only)
FS_LLM_BASE_URL=http://localhost:11434/v1

# Model name as recognised by the serving endpoint. Purely a config choice:
# a small model for development, a larger one for real runs, no code change.
# Each extraction records which model produced it.
FS_LLM_MODEL=llama3.2

# Local servers ignore this, but the OpenAI client refuses to start without it
FS_LLM_API_KEY=not-needed

# Seconds to wait on one extraction call before giving up on it
FS_LLM_TIMEOUT=120.0

# Total tries per raw item, including the first
FS_LLM_MAX_ATTEMPTS=3

# How the scraper identifies itself. Keep a contact URL in it — an operator
# who wants to complain should not have to guess who is crawling them.
FS_SCRAPER_USER_AGENT='FinalScoring/0.0.1 (+https://finalscoring.games/)'

# Minimum seconds between scraper requests (politeness delay)
FS_SCRAPER_DELAY=1.0

# Parallel requests allowed per domain
FS_SCRAPER_CONCURRENCY=4

# Where spiders write their JSON Lines output
FS_RESULTS_DIR=data/results

# Where Scrapy keeps resume state, so an interrupted crawl can continue
FS_JOBS_DIR=data/jobs

# Path for the output SQLite database file. Kept out of FS_RESULTS_DIR: that
# holds intermediate artifacts a rebuild can regenerate, whereas this is the
# build's product and the thing worth sharing between machines.
FS_DB_PATH=data/finalscoring.db

# --- docker compose only (the application itself ignores this) ---

# Host directory holding the Recommend.Games luding scrape (luding_GameItem.jl).
# Bind-mounted read-only for the `luding` service. Relative paths resolve from
# the repo root; use an absolute path if your checkout layout differs.
FS_LUDING_DIR=../../Recommend.Games/board-game-data/scraped
